rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      // In this version, we use custom phone/password sessions
      return true; 
    }

    function isEmailVerified() {
      return true;
    }

    function getUserData() {
      return {}; // Custom auth doesn't populate request.auth
    }

    function isSuperAdmin() {
      return true; // Prototype mode
    }

    function isDistributor(distId) {
      return true; 
    }

    function isOwner(storeId) {
      return true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- USERS ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.phone is string && data.phone.size() <= 20
          && data.role in ['super_admin', 'store_owner', 'distributor']
          && data.status in ['active', 'suspended', 'deleted'];
      }

      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow list: if true;
    }

    // --- STORES ---
    match /stores/{storeId} {
      function isValidStore(data) {
        return data.name is string && data.name.size() <= 100
          && data.ownerId is string;
      }

      allow create: if true;
      allow read: if true;
      allow update: if true;
      allow delete: if true;
      allow list: if true; 
    }

    // Test connection
    match /test/{docId} {
      allow read: if true;
    }

    // Distributors
    match /distributors/{distId} {
      allow read, write: if true;
    }

    // --- PAYMENTS ---
    match /payments/{paymentId} {
      allow read, list, write: if isSuperAdmin();
    }

    // --- PLANS ---
    match /plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // --- SUB-COLLECTIONS ---
    
    // Products
    match /stores/{storeId}/products/{productId} {
      allow read, write: if true;
    }

    // Sales
    match /stores/{storeId}/sales/{saleId} {
      allow read, write: if true;
    }

    // Marketplace
    match /marketplace/{productId} {
      allow read: if isSignedIn();
      allow create, update: if isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)));
      allow delete: if isSuperAdmin();
    }
  }
}
